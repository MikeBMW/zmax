[Unit]
Description=Z-MAX 框架服务网关 (:8788) — 服务注册 / 分层门户 / 健康聚合 / 反向代理
Documentation=file:///home/ubuntu/zmax/services/registry.json
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zmax
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/zmax/gui-venv311/bin/python /home/ubuntu/zmax/services/framework_gateway.py --port 8788
Restart=always
RestartSec=3
# 常驻静音: 不刷屏, 只留 journal 兜底
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
