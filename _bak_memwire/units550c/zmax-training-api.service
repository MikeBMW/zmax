[Unit]
Description=ZMAX Training API (39061)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/intel/zmax_web_svc
ExecStart=/usr/bin/python3 /home/intel/zmax_web_svc/training-api.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
