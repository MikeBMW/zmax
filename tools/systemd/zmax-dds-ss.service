[Unit]
Description=Z-MAX 全局数据空间发布守护 (状态空间真实数据源 → DDS, 受遥测模式控制)
Documentation=file:/home/ubuntu/zmax/docs/design/global_data_space_mapping_20260929.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zmax
Environment=ZMAX_REPO=/home/ubuntu/zmax
Environment=PYTHONUNBUFFERED=1
# 🔴 2026-10-13 单播发现: 见 dds/cyclonedds_unicast.xml 头注 (多播+多网卡 ⇒ 本机自己都收不到)
Environment=CYCLONEDDS_URI=file:///home/ubuntu/zmax/dds/cyclonedds_unicast.xml
ExecStart=/home/ubuntu/zmax/venvs/dds-venv/bin/python /home/ubuntu/zmax/tools/dds/ss_daemon.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/zmax-dds-ss.log
StandardError=append:/var/log/zmax-dds-ss.log

[Install]
WantedBy=multi-user.target
