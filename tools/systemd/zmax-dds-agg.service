[Unit]
Description=Z-MAX DDS 硬件汇聚器 (DDS→relay)
Documentation=file:/home/ubuntu/zmax/docs/design/global_data_space_mapping_20260929.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/zmax
Environment=ZMAX_REPO=/home/ubuntu/zmax
Environment=PYTHONUNBUFFERED=1
# 🔴 2026-10-13 单播发现 (与探针/发布端/ss 守护同一张配置, 口径只有一份)
Environment=CYCLONEDDS_URI=file:///home/ubuntu/zmax/dds/cyclonedds_unicast.xml
ExecStart=/home/ubuntu/zmax/venvs/dds-venv/bin/python /home/ubuntu/zmax/tools/dds/aggregator.py --watch 5
Restart=always
RestartSec=5
StandardOutput=append:/var/log/zmax-dds-agg.log
StandardError=append:/var/log/zmax-dds-agg.log

[Install]
WantedBy=multi-user.target
