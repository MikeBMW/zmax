[Unit]
Description=Z-MAX 融合定位建图 · 自动加载建图程序 (ORB 视觉 + 机器人位姿; 550A 自主进化模式)
Documentation=file:///home/ubuntu/zmax/docs/design/空间质数结构化理解能力_设计_v1.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
WorkingDirectory=/home/ubuntu/zmax
Environment=PYTHONPATH=/home/ubuntu/zmax/src
Environment=QT_QPA_PLATFORM=offscreen
# 进系统即自动加载建图并启动建图程序 (幂等: 已在跑则不重复启动; 真源 auto_load=false 则拒绝)
ExecStart=/home/ubuntu/zmax/gui-venv311/bin/python /home/ubuntu/zmax/tools/mapping_autostart.py start --n 30 --interval 0.5
# 停服务按 pid 文件停 (禁 ps|grep 按名匹配)
ExecStop=/home/ubuntu/zmax/gui-venv311/bin/python /home/ubuntu/zmax/tools/mapping_autostart.py stop
TimeoutStartSec=120
TimeoutStopSec=60
Restart=no

[Install]
WantedBy=multi-user.target
