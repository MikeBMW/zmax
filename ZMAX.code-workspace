{
  "folders": [
    {
      "name": "框架  (~/zmax/src/lerobot)",
      "path": "src/lerobot"
    },
    {
      "name": "控制台  (~/zmax/tools/gui)",
      "path": "tools/gui"
    },
    {
      "name": "文档  (~/zmax/docs)",
      "path": "docs"
    },
    {
      "name": "工程  (/home/ubuntu/zmax)",
      "path": "."
    }
  ],
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🧪 断点 · 整个 GUI (studio.py · 550B 单线程)",
        "type": "python",
        "request": "launch",
        "program": "/home/ubuntu/zmax/tools/gui/studio.py",
        "python": "/home/ubuntu/zmax/gui-venv311/bin/python",
        "pythonArgs": [
          "-X",
          "frozen_modules=off"
        ],
        "cwd": "/home/ubuntu/zmax/tools/gui",
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {
          "DISPLAY": ":0",
          "QT_QPA_PLATFORM": "xcb",
          "ZMAX_SINGLE_THREAD": "1",
          "ZMAX_BREAK_SKILL": "1",
          "PYTHONUNBUFFERED": "1",
          "PYDEVD_DISABLE_FILE_VALIDATION": "1",
          "HF_HUB_OFFLINE": "1",
          "TRANSFORMERS_OFFLINE": "1"
        }
      }
    ]
  },
  "settings": {
    "window.title": "${activeEditorLong}${separator}${appName}",
    "breadcrumbs.enabled": true,
    "files.watcherExclude": {
      "**/.git/**": true,
      "**/__pycache__/**": true,
      "**/*.pyc": true,
      "**/reports/**": true,
      "**/zmax_data/**": true,
      "**/data/**": true,
      "**/runs/**": true,
      "**/outputs/**": true,
      "**/external/**": true,
      "**/models/**": true,
      "**/gui-venv311/**": true,
      "**/*.jsonl": true,
      "**/*.mp4": true,
      "**/*.npz": true,
      "**/*.pt": true,
      "**/*.pth": true
    },
    "search.exclude": {
      "**/reports/**": true,
      "**/zmax_data/**": true,
      "**/data/**": true,
      "**/runs/**": true,
      "**/outputs/**": true,
      "**/external/**": true,
      "**/models/**": true,
      "**/gui-venv311/**": true,
      "**/*.jsonl": true
    },
    "python.analysis.exclude": [
      "**/reports/**",
      "**/zmax_data/**",
      "**/data/**",
      "**/runs/**",
      "**/outputs/**",
      "**/external/**",
      "**/models/**",
      "**/gui-venv311/**"
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.defaultInterpreterPath": "/home/ubuntu/zmax/gui-venv311/bin/python",
    "git.autoRepositoryDetection": "openEditors",
    "git.repositoryScanMaxDepth": 1,
    "git.autorefresh": false,
    "search.followSymlinks": false,
    "telemetry.telemetryLevel": "off",
    "files.maxMemoryForLargeFilesMB": 4096
  }
}