{
  "folders": [
    {
      "name": "框架  (~/zmax/src/lerobot)",
      "path": "src/lerobot"
    },
    {
      "name": "控制台  (~/zmax/tools/gui)",
      "path": "tools/gui"
    },
    {
      "name": "文档  (~/zmax/docs)",
      "path": "docs"
    },
    {
      "name": "工程  (/home/ubuntu/zmax)",
      "path": "."
    },
    {
      "path": "gui-venv311/lib/python3.11/site-packages/ultralytics"
    },
    {
      "path": "src/lerobot/policies/yolo_3d"
    }
  ],
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🧠 后端工程 · 调度状态机 (start.py)",
        "type": "python",
        "request": "launch",
        "program": "/home/ubuntu/zmax/src/lerobot/engineering/start.py",
        "python": "/home/ubuntu/zmax/gui-venv311/bin/python",
        "pythonArgs": [
          "-X",
          "frozen_modules=off"
        ],
        "cwd": "/home/ubuntu/zmax",
        "console": "integratedTerminal",
        "justMyCode": false,
        "stopOnEntry": false,
        "env": {
          "PYTHONPATH": "/home/ubuntu/zmax/src:/home/ubuntu/zmax/tools",
          "PYTHONUNBUFFERED": "1",
          "PYDEVD_DISABLE_FILE_VALIDATION": "1",
          "ZMAX_FSM": "1",
          "ZMAX_ORCH": "1",
          "ZMAX_AUTO_TRAJ": "1",
          "ZMAX_TRAJ_CHUNK": "10",
          "ZMAX_TRAJ_SPEED": "40",
          "ZMAX_DISPATCH_INPROC": "0",
          "OMP_NUM_THREADS": "4",
          "MKL_NUM_THREADS": "4"
        }
      },
      {
        "name": "🎯 断点 · 状态空间常驻循环 (ss_canvas_loop → fuse_sensors)",
        "type": "python",
        "request": "launch",
        "program": "/home/ubuntu/zmax/tools/ss_canvas_loop.py",
        "python": "/home/ubuntu/zmax/gui-venv311/bin/python",
        "pythonArgs": [
          "-X",
          "frozen_modules=off"
        ],
        "cwd": "/home/ubuntu/zmax",
        "console": "integratedTerminal",
        "justMyCode": false,
        "stopOnEntry": false,
        "env": {
          "ZMAX_DEBUG_FUSE": "1",
          "ZMAX_DISPATCH_INPROC": "0",
          "PYTHONUNBUFFERED": "1",
          "PYDEVD_DISABLE_FILE_VALIDATION": "1"
        }
      },
      {
        "name": "🖥 前端 GUI · 控制台可视化 (studio.py)",
        "type": "python",
        "request": "launch",
        "program": "/home/ubuntu/zmax/tools/gui/studio.py",
        "python": "/home/ubuntu/zmax/gui-venv311/bin/python",
        "pythonArgs": [
          "-X",
          "frozen_modules=off"
        ],
        "cwd": "/home/ubuntu/zmax/tools/gui",
        "console": "integratedTerminal",
        "justMyCode": false,
        "stopOnEntry": false,
        "env": {
          "DISPLAY": ":0",
          "QT_QPA_PLATFORM": "xcb",
          "ZMAX_SINGLE_THREAD": "1",
          "PYTHONUNBUFFERED": "1",
          "PYDEVD_DISABLE_FILE_VALIDATION": "1",
          "HF_HUB_OFFLINE": "1",
          "TRANSFORMERS_OFFLINE": "1"
        }
      }
    ]
  },
  "settings": {
    "window.title": "${activeEditorLong}${separator}${appName}",
    "breadcrumbs.enabled": true,
    "files.watcherExclude": {
      "**/.git/**": true,
      "**/__pycache__/**": true,
      "**/*.pyc": true,
      "**/reports/**": true,
      "**/zmax_data/**": true,
      "**/data/**": true,
      "**/runs/**": true,
      "**/outputs/**": true,
      "**/external/**": true,
      "**/models/**": true,
      "**/gui-venv311/**": true,
      "**/*.jsonl": true,
      "**/*.mp4": true,
      "**/*.npz": true,
      "**/*.pt": true,
      "**/*.pth": true
    },
    "search.exclude": {
      "**/reports/**": true,
      "**/zmax_data/**": true,
      "**/data/**": true,
      "**/runs/**": true,
      "**/outputs/**": true,
      "**/external/**": true,
      "**/models/**": true,
      "**/gui-venv311/**": true,
      "**/*.jsonl": true
    },
    "python.analysis.exclude": [
      "**/reports/**",
      "**/zmax_data/**",
      "**/data/**",
      "**/runs/**",
      "**/outputs/**",
      "**/external/**",
      "**/models/**",
      "**/gui-venv311/**"
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.defaultInterpreterPath": "/home/ubuntu/zmax/gui-venv311/bin/python",
    "git.autoRepositoryDetection": "openEditors",
    "git.repositoryScanMaxDepth": 1,
    "git.autorefresh": false,
    "search.followSymlinks": false,
    "telemetry.telemetryLevel": "off",
    "files.maxMemoryForLargeFilesMB": 4096
  }
}