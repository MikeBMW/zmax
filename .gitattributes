# ===== 跨平台换行统一 (2026-11-26) =====================================
# 目标: Ubuntu(LF) 与 Windows 检出的工作区字节完全一致, 不再出现"两个版本"。
# 下游 LFS / !text 规则仍会覆盖本段 (gitattributes 后匹配者优先)。
* text=auto eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.htm     text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.css     text eol=lf
*.java    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.service text eol=lf
*.desktop text eol=lf
*.timer   text eol=lf
# Windows 专属脚本保留 CRLF, 避免 cmd.exe / WSH 解析异常
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.vbs     text eol=crlf
# 二进制: 禁止任何文本转换
*.exe     binary
*.ico     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.zip     binary
*.zst     binary
# =======================================================================

*.memmap filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.arrow filter=lfs diff=lfs merge=lfs -text
*.json !text !filter !merge !diff
tests/artifacts/cameras/*.png filter=lfs diff=lfs merge=lfs -text
*.bag filter=lfs diff=lfs merge=lfs -text
