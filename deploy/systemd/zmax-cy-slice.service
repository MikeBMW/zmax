[Unit]
Description=ZMAX Calabi-Yau slice web service (genus-6 hole visualization, port 8810)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/zmax
Environment=ZMAX_CY_PORT=8810
ExecStart=/home/ubuntu/zmax/gui-venv311/bin/python /home/ubuntu/zmax/tools/cy_slice_server.py
Restart=always
RestartSec=3
StandardOutput=append:/var/log/zmax-cy-slice.log
StandardError=append:/var/log/zmax-cy-slice.log

[Install]
WantedBy=multi-user.target
