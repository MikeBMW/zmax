# /etc/systemd/system/zmax-hjepa-mr-evolve.service
# H-JEPA-MR 几何分支自主进化守护 (Intel Arc B390)
#
# 老倪 2026-10-23: 「部署到 550C 自主进化」
# 进化器本身跑 N 代就退出 (台账 ~/hjepa_mr/evolve_ledger.json 跨轮续), 外层 while 循环
# 让它常驻。每轮 6 代约 40~80s, 冷却 180s (不烧满 GPU, 也给 YOLO 进化让路)。
[Unit]
Description=Z-MAX H-JEPA-MR 几何分支自主进化守护 (550C, 几何自洽适应度)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=intel
Group=intel
WorkingDirectory=/home/intel/hjepa_mr
Environment=LD_LIBRARY_PATH=/home/intel/train_venv/lib
Environment=ZMAX_ROOT=/home/intel/hjepa_mr
Environment=PYTHONPATH=/home/intel/hjepa_mr
Environment=MR_GENS=6
Environment=MR_FRAMES=80
Environment=MR_MARGIN=0.002
Environment=MR_SEED=0
# 前置: XPU 必须可用 (XPU 不可用时几何分支照样能跑 CPU, 但那样就没意义了)
ExecStartPre=/home/intel/train_venv/bin/python -c "import torch; assert torch.xpu.is_available(), 'XPU 不可用'"
ExecStart=/bin/bash -lc 'mkdir -p /home/intel/hjepa_mr && while true; do /home/intel/train_venv/bin/python -u /home/intel/hjepa_mr/evolve.py; echo "--- 冷却 180s ---"; sleep 180; done'
Restart=always
RestartSec=30
StandardOutput=append:/home/intel/hjepa_mr/evolve.log
StandardError=append:/home/intel/hjepa_mr/evolve.log

[Install]
WantedBy=multi-user.target
